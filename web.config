<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <asp scriptErrorSentToBrowser="true" enableParentPaths="true" />
    <httpErrors errorMode="Detailed" existingResponse="PassThrough" />
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>
</configuration>
